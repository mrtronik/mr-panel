<%- body %>
<footer class="panel-footer"> <%= typeof appName !== 'undefined' ? appName : 'MR Panel' %> &copy; <%= new Date().getFullYear() %> — Powered by <a href="https://mrpanel.my.id" target="_blank" title="Indonesian Web Hosting Tools"> MR Panel</a> | <a href="#">Docs</a> | <a href="#">Support</a>

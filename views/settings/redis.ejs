<script>
let currentCursor = 0;
let allKeys = [];

async function loadKeys(pattern = '*', cursor = 0) {
    try {
        const res = await fetch(`/api/redis/keys?pattern=${encodeURIComponent(pattern)}&cursor=${cursor}&count=50`);
        const data = await res.json();
        
        if (data.success) {
            const tbody = document.getElementById('keysBody');
            if (cursor === 0) {
                tbody.innerHTML = '';
                allKeys = [];
            }
            
            data.data.keys.forEach(key => {
                allKeys.push(key);
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><code class="text-primary">${escapeHtml(key.key)}</code></td>
                    <td><span class="badge bg-secondary">${key.type}</span></td>
                    <td><small>${key.ttlFormatted}</small></td>
                    <td>${key.size}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-info" onclick="viewKey('${escapeHtml(key.key)}')"><i class="ri-eye-line"></i></button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteKey('${escapeHtml(key.key)}')"><i class="ri-delete-bin-line"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            
            currentCursor = data.data.cursor;
            document.getElementById('loadMoreBtn').style.display = data.data.hasMore ? 'inline-block' : 'none';
            
            if (allKeys.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Tidak ada key ditemukan</td></tr>';
            }
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}

function searchKeys() {
    const pattern = document.getElementById('keyPattern').value || '*';
    loadKeys(pattern, 0);
}

function loadMoreKeys() {
    const pattern = document.getElementById('keyPattern').value || '*';
    loadKeys(pattern, currentCursor);
}

async function viewKey(key) {
    try {
        const res = await fetch(`/api/redis/key/${encodeURIComponent(key)}`);
        const data = await res.json();
        
        if (data.success) {
            const k = data.data;
            let valueHtml = '';
            
            if (k.type === 'string') {
                valueHtml = `<pre class="bg-light p-3">${escapeHtml(typeof k.value === 'object' ? JSON.stringify(k.value, null, 2) : k.value)}</pre>`;
            } else if (k.type === 'hash') {
                valueHtml = '<table class="table table-sm"><thead><tr><th>Field</th><th>Value</th></tr></thead><tbody>';
                for (const [field, val] of Object.entries(k.value)) {
                    valueHtml += `<tr><td><code>${escapeHtml(field)}</code></td><td><code>${escapeHtml(val)}</code></td></tr>`;
                }
                valueHtml += '</tbody></table>';
            } else if (['list', 'set'].includes(k.type)) {
                valueHtml = '<ul class="list-group">';
                k.value.forEach(v => {
                    valueHtml += `<li class="list-group-item"><code>${escapeHtml(v)}</code></li>`;
                });
                valueHtml += '</ul>';
            } else if (k.type === 'zset') {
                valueHtml = '<table class="table table-sm"><thead><tr><th>Member</th><th>Score</th></tr></thead><tbody>';
                for (let i = 0; i < k.value.length; i += 2) {
                    valueHtml += `<tr><td><code>${escapeHtml(k.value[i])}</code></td><td>${k.value[i+1]}</td></tr>`;
                }
                valueHtml += '</tbody></table>';
            }
            
            document.getElementById('keyDetailContent').innerHTML = `
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Key:</strong> <code class="text-primary">${escapeHtml(k.key)}</code>
                    </div>
                    <div class="col-md-3">
                        <strong>Type:</strong> <span class="badge bg-secondary">${k.type}</span>
                    </div>
                    <div class="col-md-3">
                        <strong>TTL:</strong> ${k.ttlFormatted}
                    </div>
                </div>
                <hr>
                <h6>Value:</h6>
                ${valueHtml}
            `;
            
            new bootstrap.Modal(document.getElementById('keyDetailModal')).show();
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}

async function deleteKey(key) {
    const result = await Swal.fire({
        title: 'Hapus Key?',
        text: `Key "${key}" akan dihapus permanen`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Hapus'
    });
    
    if (result.isConfirmed) {
        try {
            const res = await fetch(`/api/redis/key/${encodeURIComponent(key)}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', 'Key berhasil dihapus', 'success');
                searchKeys();
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function deleteByPattern() {
    const pattern = document.getElementById('deletePattern').value;
    if (!pattern) {
        Swal.fire('Error', 'Masukkan pattern', 'error');
        return;
    }
    
    const result = await Swal.fire({
        title: 'Hapus by Pattern?',
        text: `Semua key yang match "${pattern}" akan dihapus`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Hapus'
    });
    
    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/redis/delete-pattern', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pattern })
            });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', `${data.count} key berhasil dihapus`, 'success');
                searchKeys();
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function flushDb() {
    const db = document.getElementById('flushDb').value;
    const result = await Swal.fire({
        title: `Flush DB ${db}?`,
        text: `Semua key di database ${db} akan dihapus permanen`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Flush'
    });
    
    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/redis/flush-db', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ db: parseInt(db) })
            });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', data.message, 'success');
                window.location.reload();
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function flushAll() {
    const result = await Swal.fire({
        title: 'Flush ALL Databases?',
        text: 'SEMUA data di SEMUA database Redis akan dihapus permanen!',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Flush All',
        html: '<p class="text-danger">Tindakan ini tidak dapat dibatalkan!</p>'
    });
    
    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/redis/flush-all', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', data.message, 'success');
                window.location.reload();
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function loadDatabases() {
    try {
        const res = await fetch('/api/redis/databases');
        const data = await res.json();
        
        if (data.success) {
            const container = document.getElementById('dbList');
            container.innerHTML = '';
            
            data.data.forEach(db => {
                const div = document.createElement('div');
                div.className = 'd-flex justify-content-between align-items-center p-2 border-bottom';
                div.innerHTML = `
                    <div>
                        <strong>DB ${db.id}</strong>
                        ${db.keys > 0 ? `<span class="badge bg-primary ms-2">${db.keys} keys</span>` : ''}
                    </div>
                    <small class="text-muted">${db.expires > 0 ? db.expires + ' expiring' : ''}</small>
                `;
                container.appendChild(div);
            });
        }
    } catch (err) {
        document.getElementById('dbList').innerHTML = '<div class="text-danger">Gagal load databases</div>';
    }
}

async function loadSlowLog() {
    try {
        const res = await fetch('/api/redis/slow-log?count=10');
        const data = await res.json();
        
        if (data.success) {
            const tbody = document.getElementById('slowLogBody');
            tbody.innerHTML = '';
            
            if (data.data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Tidak ada slow log</td></tr>';
                return;
            }
            
            data.data.forEach(log => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><small>${new Date(log.timestamp).toLocaleString()}</small></td>
                    <td><span class="badge bg-warning">${log.durationMs}</span></td>
                    <td><code>${escapeHtml(log.command)}</code></td>
                    <td><small>${log.clientIp}</small></td>
                `;
                tbody.appendChild(tr);
            });
        }
    } catch (err) {
        document.getElementById('slowLogBody').innerHTML = '<tr><td colspan="4" class="text-danger">Gagal load slow log</td></tr>';
    }
}

function escapeHtml(text) {
    if (!text) return '';
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return String(text).replace(/[&<>"']/g, m => map[m]);
}

document.addEventListener('DOMContentLoaded', () => {
    loadKeys();
    loadDatabases();
    loadSlowLog();
    
    document.getElementById('keyPattern')?.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') searchKeys();
    });
});
</script>

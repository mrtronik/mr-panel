<section class="about__area section-space-top section-space-bottom-1">
                <div class="container">

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="ri-filter-line" style="font-size: 2rem;"></i>
                <h5 class="mt-2 mb-0"><%= stats.total %></h5>
                <small>Total Rules</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <i class="ri-check-line" style="font-size: 2rem;"></i>
                <h5 class="mt-2 mb-0"><%= stats.active %></h5>
                <small>Active Rules</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="ri-information-line" style="font-size: 2rem;"></i>
                <h5 class="mt-2 mb-0"><%= stats.total - stats.active %></h5>
                <small>Inactive Rules</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Add New Rule Form -->
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header"><strong><i class="ri-add-circle-line"></i> Add New Rule</strong></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Rule Name</label>
                    <input type="text" class="form-control" id="ruleName" placeholder="e.g., Forward invoices">
                </div>
                <div class="mb-3">
                    <label class="form-label">Rule Type</label>
                    <select class="form-select" id="ruleType" onchange="toggleRuleFields()">
                        <option value="all">All Emails</option>
                        <option value="keyword">By Keyword</option>
                        <option value="domain">By Domain</option>
                    </select>
                </div>
                <div class="mb-3" id="keywordField" style="display:none;">
                    <label class="form-label">Keyword</label>
                    <input type="text" class="form-control" id="keyword" placeholder="e.g., invoice, payment">
                    <small class="text-muted">Forward email yang mengandung keyword ini di subject/body</small>
                </div>
                <div class="mb-3" id="domainField" style="display:none;">
                    <label class="form-label">Domain</label>
                    <input type="text" class="form-control" id="domain" placeholder="e.g., example.com">
                    <small class="text-muted">Forward semua email dari domain ini</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Action</label>
                    <select class="form-select" id="action">
                        <option value="forward">Forward (hapus dari inbox)</option>
                        <option value="forward_copy">Forward + Keep Copy</option>
                        <option value="redirect">Redirect (ganti tujuan)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Destination Email</label>
                    <input type="email" class="form-control" id="destinationEmail" placeholder="target@gmail.com">
                </div>
                <div class="mb-3">
                    <label class="form-label">Priority</label>
                    <input type="number" class="form-control" id="priority" value="0" min="0" max="100">
                    <small class="text-muted">Higher priority = processed first</small>
                </div>
                <button class="btn btn-primary w-100" onclick="createRule()"><i class="ri-save-line"></i> Create Rule</button>
            </div>
        </div>

        <!-- Info -->
        <div class="card mb-4">
            <div class="card-header"><strong><i class="ri-lightbulb-line"></i> Tips</strong></div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="ri-arrow-right-s-line text-primary"></i> <strong>All Emails:</strong> Forward semua email ke destination</li>
                    <li class="mb-2"><i class="ri-arrow-right-s-line text-success"></i> <strong>By Keyword:</strong> Forward yang mengandung keyword</li>
                    <li class="mb-2"><i class="ri-arrow-right-s-line text-warning"></i> <strong>By Domain:</strong> Forward dari domain tertentu</li>
                    <li><i class="ri-arrow-right-s-line text-danger"></i> <strong>Redirect:</strong> Ganti tujuan, tidak ada copy di inbox</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Rules List -->
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <strong><i class="ri-list-check"></i> Forwarding Rules</strong>
                <div class="float-end">
                    <button class="btn btn-sm btn-outline-success" onclick="applyToPostfix()"><i class="ri-server-line"></i> Apply to Postfix</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-sm" id="rulesTable">
                        <thead>
                            <tr>
                                <th width="30">#</th>
                                <th>Rule Name</th>
                                <th>Type</th>
                                <th>Condition</th>
                                <th>Action</th>
                                <th>Destination</th>
                                <th>Status</th>
                                <th width="120">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (rules.length === 0) { %>
                            <tr><td colspan="8" class="text-center text-muted">Belum ada forwarding rules</td></tr>
                            <% } else { %>
                            <% rules.forEach((rule, idx) => { %>
                            <tr>
                                <td><%= idx + 1 %></td>
                                <td><strong><%= rule.rule_name %></strong></td>
                                <td><span class="badge bg-secondary"><%= rule.rule_type %></span></td>
                                <td>
                                    <% if (rule.rule_type === 'keyword') { %>
                                    <code><%= rule.keyword %></code>
                                    <% } else if (rule.rule_type === 'domain') { %>
                                    <code>@<%= rule.domain %></code>
                                    <% } else { %>
                                    <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td><span class="badge bg-<%= rule.action === 'forward' ? 'primary' : rule.action === 'forward_copy' ? 'info' : 'warning' %>"><%= rule.action %></span></td>
                                <td><%= rule.destination_email %></td>
                                <td>
                                    <span class="badge bg-<%= rule.status === 'active' ? 'success' : 'secondary' %>">
                                        <%= rule.status %>
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-<%= rule.status === 'active' ? 'warning' : 'success' %>" onclick="toggleRule(<%= rule.id %>)">
                                        <i class="ri-<%= rule.status === 'active' ? 'pause' : 'play' %>-line"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteRule(<%= rule.id %>)">
                                        <i class="ri-delete-bin-line"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

    </div>
</section>

<script>
function toggleRuleFields() {
    const type = document.getElementById('ruleType').value;
    document.getElementById('keywordField').style.display = type === 'keyword' ? 'block' : 'none';
    document.getElementById('domainField').style.display = type === 'domain' ? 'block' : 'none';
}

async function createRule() {
    const data = {
        rule_name: document.getElementById('ruleName').value.trim(),
        rule_type: document.getElementById('ruleType').value,
        keyword: document.getElementById('keyword').value.trim() || null,
        domain: document.getElementById('domain').value.trim() || null,
        action: document.getElementById('action').value,
        destination_email: document.getElementById('destinationEmail').value.trim(),
        priority: parseInt(document.getElementById('priority').value) || 0
    };

    if (!data.rule_name) {
        Swal.fire('Error', 'Rule name harus diisi', 'error');
        return;
    }
    if (!data.destination_email) {
        Swal.fire('Error', 'Destination email harus diisi', 'error');
        return;
    }

    try {
        const res = await fetch('/api/forwarding/rules', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        
        if (result.success) {
            Swal.fire('Berhasil', 'Rule berhasil dibuat', 'success')
                .then(() => window.location.reload());
        } else {
            Swal.fire('Error', result.message, 'error');
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}

async function toggleRule(id) {
    try {
        const res = await fetch(`/api/forwarding/rules/${id}/toggle`, { method: 'POST' });
        const result = await res.json();
        if (result.success) {
            window.location.reload();
        } else {
            Swal.fire('Error', result.message, 'error');
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}

async function deleteRule(id) {
    const result = await Swal.fire({
        title: 'Hapus Rule?',
        text: 'Rule ini akan dihapus permanen',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Hapus'
    });

    if (result.isConfirmed) {
        try {
            const res = await fetch(`/api/forwarding/rules/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', 'Rule berhasil dihapus', 'success')
                    .then(() => window.location.reload());
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function applyToPostfix() {
    Swal.fire({
        title: 'Applying to Postfix...',
        text: 'Mengirim konfigurasi ke mail server',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    try {
        const res = await fetch('/api/forwarding/apply', { method: 'POST' });
        const data = await res.json();
        
        if (data.success) {
            Swal.fire('Berhasil', `${data.data.rulesCount} rules berhasil diterapkan`, 'success');
        } else {
            Swal.fire('Error', data.message, 'error');
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}
</script>

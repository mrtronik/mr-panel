<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box justify-content-between d-flex align-items-lg-center flex-lg-row flex-column">
                    <h4 class="page-title"><i class="ri-package-line me-2"></i>Packages</h4>
                    <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addPackageModal">
                        <i class="ri-add-line me-1"></i>Add Package
                    </button>
                </div>
            </div>
        </div>

        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="row">
            <% packages.forEach(function(pkg) { %>
            <div class="col-xl-3 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0"><%= pkg.name %></h5>
                            <span class="badge bg-primary text-white">Rp <%= pkg.price.toLocaleString() %>/mo</span>
                        </div>
                        <hr>
                        <div class="mb-2">
                            <small class="text-muted">Disk Space</small>
                            <div class="progress progress-sm mt-1">
                                <div class="progress-bar bg-info" style="width: 30%"></div>
                            </div>
                            <small><%= formatSize(pkg.disk_limit) %></small>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Bandwidth</small>
                            <div class="progress progress-sm mt-1">
                                <div class="progress-bar bg-success" style="width: 20%"></div>
                            </div>
                            <small><%= formatSize(pkg.bandwidth_limit) %>/mo</small>
                        </div>
                        <hr>
                        <div class="row text-center">
                            <div class="col-4">
                                <h6 class="mb-0"><%= pkg.max_domains %></h6>
                                <small class="text-muted">Domains</small>
                            </div>
                            <div class="col-4">
                                <h6 class="mb-0"><%= pkg.max_email %></h6>
                                <small class="text-muted">Email</small>
                            </div>
                            <div class="col-4">
                                <h6 class="mb-0"><%= pkg.max_database %></h6>
                                <small class="text-muted">Database</small>
                            </div>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <form action="/packages/<%= pkg.id %>/delete" method="POST" onsubmit="event.preventDefault(); confirmDelete(this, 'Delete this package?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ri-delete-bin-line"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
</div>

<div class="modal fade" id="addPackageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/packages">
                <div class="modal-header">
                    <h5 class="modal-title">Add Package</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Package Name *</label>
                        <input type="text" class="form-control" name="name" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Disk Space (GB)</label>
                            <input type="number" class="form-control" name="disk_limit" value="1" min="1">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Bandwidth (GB)</label>
                            <input type="number" class="form-control" name="bandwidth_limit" value="10" min="1">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Max Domains</label>
                            <input type="number" class="form-control" name="max_domains" value="10" min="0">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Max Email</label>
                            <input type="number" class="form-control" name="max_email" value="10" min="0">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Max Database</label>
                            <input type="number" class="form-control" name="max_database" value="10" min="0">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Price (Rp/mo)</label>
                        <input type="number" class="form-control" name="price" value="0" min="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Package</button>
                </div>
            </form>
        </div>
    </div>
</div>

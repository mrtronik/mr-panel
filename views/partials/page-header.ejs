 

<%
const btns = typeof buttons !== 'undefined' ? buttons : [];
const crumbs = typeof breadcrumb !== 'undefined' ? breadcrumb : [];

const colors = {
    blue: {
        solid: 'text-white bg-blue-500 hover:bg-blue-600 focus:ring-blue-300',
        outline: 'text-blue-500 border border-blue-500 hover:text-white hover:bg-blue-500 focus:ring-blue-300'
    },
    green: {
        solid: 'text-white bg-green-500 hover:bg-green-600 focus:ring-green-300',
        outline: 'text-green-500 border border-green-500 hover:text-white hover:bg-green-500 focus:ring-green-300'
    },
    red: {
        solid: 'text-white bg-red-500 hover:bg-red-600 focus:ring-red-300',
        outline: 'text-red-500 border border-red-500 hover:text-white hover:bg-red-500 focus:ring-red-300'
    },
    gray: {
        solid: 'text-gray-700 bg-gray-100 hover:bg-gray-200 focus:ring-gray-300',
        outline: 'text-gray-500 border border-gray-400 hover:text-white hover:bg-gray-500 focus:ring-gray-300'
    }
};
%>

<div class="container mx-auto px-5">
    <div class="flex flex-wrap">
        <div class="flex items-center py-4 w-full">
            <div class="flex justify-between w-full items-center">

                <div>
                    <h1 class="font-semibold text-xl mb-1">
                        <%= title %>
                    </h1>

                    <ol class="flex text-sm">
                        <!-- Item 1: Dashboard (selalu ada) -->
                        <li>
                            <a href="/dashboard" class="text-gray-500 hover:text-blue-500">
                                MR Panel
                            </a>
                        </li>

                        <!-- Item 2-3: Dynamic breadcrumb -->
                        <% crumbs.forEach((crumb, i) => { %>
                            <li class="mx-2 text-gray-500">/</li>

                            <% if (i === crumbs.length - 1) { %>
                                <!-- 👇 Last item = current page, NO link -->
                                <li class="text-gray-700 font-medium">
                                    <%= crumb.text %>
                                </li>
                            <% } else { %>
                                <!-- 👇 Middle item = HAS link -->
                                <li>
                                    <a href="<%= crumb.url %>" class="text-gray-500 hover:text-blue-500">
                                        <%= crumb.text %>
                                    </a>
                                </li>
                            <% } %>
                        <% }); %>
                    </ol>
                </div>

                <!-- Buttons -->
                <div class="flex items-center gap-2">
                    <% btns.forEach(btn => { 
                        const color = colors[btn.color || 'blue'];
                        const style = btn.outline ? color.outline : color.solid;
                        const target = btn.target ? `target="${btn.target}"` : '';
                    %>

                    <a href="<%= btn.url %>"
                       <%= target %>
                       class="font-medium text-xs text-center rounded px-3 py-2 focus:ring-4 focus:outline-none <%= style %>">

                        <% if(btn.icon){ %>
                            <i class="<%= btn.icon %> mr-2"></i>
                        <% } %>

                        <%= btn.text %>
                    </a>

                    <% }) %>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="container mx-auto px-5 min-h-[calc(100vh-138px)] relative pb-14">
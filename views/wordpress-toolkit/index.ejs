<main class="page-content">
  <div class="breadcrumb-bar"><a href="/dashboard">Home</a> <i class="fa-solid fa-angle-right" style="font-size:0.6rem"></i> <span>WordPress Toolkit</span></div>
  <div class="page-header">
    <h1><i class="fa-solid fa-wrench"></i> WordPress Toolkit</h1>
    <p class="subtitle">Manage all WordPress installations.</p>
  </div>

  <div class="card-soft">
    <div class="card-body" id="wpListBody">
      <div style="text-align:center;padding:30px;color:var(--text-light)"><i class="fa-solid fa-spinner fa-spin"></i> Scanning WordPress installations...</div>
    </div>
  </div>

  <div class="modal fade" id="pluginsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Plugins</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body" id="pluginsBody"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="themesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Themes</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body" id="themesBody"></div>
      </div>
    </div>
  </div>
</main>

<script>
function loadInstalls() {
  fetch('/api/wordpress-toolkit/list', {credentials:'include'})
  .then(function(r){return r.json()}).then(function(d){
    if (!d.success || d.installs.length === 0) {
      document.getElementById('wpListBody').innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-light)"><i class="fa-brands fa-wordpress" style="font-size:2rem"></i><br>No WordPress installations found</div>';
      return;
    }
    var html = '';
    d.installs.forEach(function(wp) {
      html += '<div class="d-flex align-items-center justify-content-between p-3 mb-2 border rounded">';
      html += '<div><h6 class="mb-0"><i class="fa-brands fa-wordpress" style="color:#21759b"></i> ' + wp.domain + '</h6>';
      html += '<small style="color:var(--text-muted)">WP ' + (wp.version || 'unknown') + ' | ' + wp.plugins.length + ' plugins | ' + wp.themes.length + ' themes</small></div>';
      html += '<div class="d-flex gap-1">';
      html += '<button class="btn btn-sm btn-outline-primary" onclick="updateCore(\'' + wp.domain + '\')"><i class="fa-solid fa-arrow-up"></i> Update WP</button>';
      html += '<button class="btn btn-sm btn-outline-success" onclick="showPlugins(\'' + wp.domain + '\')"><i class="fa-solid fa-puzzle-piece"></i> Plugins</button>';
      html += '<button class="btn btn-sm btn-outline-info" onclick="showThemes(\'' + wp.domain + '\')"><i class="fa-solid fa-palette"></i> Themes</button>';
      html += '<a href="http://' + wp.domain + '/wp-admin" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-external-link"></i></a>';
      html += '</div></div>';
    });
    document.getElementById('wpListBody').innerHTML = html;
  }).catch(function(){
    document.getElementById('wpListBody').innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-light)">Failed to load</div>';
  });
}

function updateCore(domain) {
  if (!confirm('Update WordPress core for ' + domain + '?')) return;
  fetch('/api/wordpress-toolkit/update-core', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({domain:domain}),credentials:'include'})
  .then(function(r){return r.json()}).then(function(d){
    if(d.success){whpToast('Updated','','success');loadInstalls()}
    else whpToast('Error',d.error,'error');
  });
}

function showPlugins(domain) {
  fetch('/api/wordpress-toolkit/plugins?domain=' + domain, {credentials:'include'})
  .then(function(r){return r.json()}).then(function(d){
    if (!d.success) return;
    var html = '<table class="table table-sm"><thead><tr><th>Plugin</th><th>Slug</th><th>Actions</th></tr></thead><tbody>';
    d.plugins.forEach(function(p) {
      var status = p.status === 'active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
      html += '<tr><td>' + p.name + '</td><td><code>' + p.slug + '</code></td><td class="d-flex gap-1">';
      if (p.status === 'active') html += '<button class="btn btn-xs btn-outline-warning" onclick="pluginAction(\'' + domain + '\',\'' + p.slug + '\',\'deactivate\')">Deactivate</button>';
      else html += '<button class="btn btn-xs btn-outline-success" onclick="pluginAction(\'' + domain + '\',\'' + p.slug + '\',\'activate\')">Activate</button>';
      html += '<button class="btn btn-xs btn-outline-danger" onclick="pluginAction(\'' + domain + '\',\'' + p.slug + '\',\'delete\')">Delete</button>';
      html += '</td></tr>';
    });
    html += '</tbody></table>';
    document.getElementById('pluginsBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('pluginsModal')).show();
  });
}

function pluginAction(domain, plugin, action) {
  if (action === 'delete' && !confirm('Delete plugin ' + plugin + '?')) return;
  fetch('/api/wordpress-toolkit/plugin', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({domain:domain,plugin:plugin,action:action}),credentials:'include'})
  .then(function(r){return r.json()}).then(function(d){
    if(d.success){whpToast('Done','','success');showPlugins(domain)}
    else whpToast('Error',d.error,'error');
  });
}

function showThemes(domain) {
  fetch('/api/wordpress-toolkit/themes?domain=' + domain, {credentials:'include'})
  .then(function(r){return r.json()}).then(function(d){
    if (!d.success) return;
    var html = '<table class="table table-sm"><thead><tr><th>Theme</th><th>Slug</th><th>Actions</th></tr></thead><tbody>';
    d.themes.forEach(function(t) {
      var status = t.status === 'active' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
      html += '<tr><td>' + t.name + ' ' + status + '</td><td><code>' + t.slug + '</code></td><td class="d-flex gap-1">';
      if (t.status !== 'active') html += '<button class="btn btn-xs btn-outline-success" onclick="themeAction(\'' + domain + '\',\'' + t.slug + '\',\'activate\')">Activate</button>';
      html += '<button class="btn btn-xs btn-outline-danger" onclick="themeAction(\'' + domain + '\',\'' + t.slug + '\',\'delete\')">Delete</button>';
      html += '</td></tr>';
    });
    html += '</tbody></table>';
    document.getElementById('themesBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('themesModal')).show();
  });
}

function themeAction(domain, theme, action) {
  if (action === 'delete' && !confirm('Delete theme ' + theme + '?')) return;
  fetch('/api/wordpress-toolkit/theme', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({domain:domain,theme:theme,action:action}),credentials:'include'})
  .then(function(r){return r.json()}).then(function(d){
    if(d.success){whpToast('Done','','success');showThemes(domain)}
    else whpToast('Error',d.error,'error');
  });
}

loadInstalls();
</script>

<style>
.webmail-container { display: flex; height: calc(100vh - 200px); min-height: 500px; }
.webmail-list { width: 380px; border-right: 1px solid #dee2e6; display: flex; flex-direction: column; background: #fff; }
.webmail-content { flex: 1; display: flex; flex-direction: column; background: #fff; overflow: hidden; }
.webmail-list-header { padding: 12px 16px; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center; }
.webmail-list-header h6 { margin: 0; font-weight: 600; }
.webmail-items { flex: 1; overflow-y: auto; }
.webmail-item { padding: 12px 16px; border-bottom: 1px solid #f0f0f0; cursor: pointer; transition: background 0.15s; }
.webmail-item:hover { background: #f8f9fa; }
.webmail-item.active { background: #e7f1ff; border-left: 3px solid #4254ba; }
.webmail-item.unread { background: #f0f7ff; }
.webmail-item.unread .webmail-subject { font-weight: 700; }
.webmail-item .webmail-from { font-weight: 600; font-size: 0.85rem; margin-bottom: 2px; }
.webmail-item .webmail-subject { font-size: 0.85rem; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.webmail-item .webmail-date { font-size: 0.75rem; color: #999; margin-top: 2px; }
.webmail-item .webmail-preview { font-size: 0.8rem; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
.webmail-content-header { padding: 16px 20px; border-bottom: 1px solid #dee2e6; }
.webmail-content-header h5 { margin: 0 0 4px 0; font-size: 1.1rem; }
.webmail-content-header .meta { font-size: 0.85rem; color: #666; }
.webmail-content-body { flex: 1; overflow-y: auto; padding: 20px; }
.webmail-empty { display: flex; align-items: center; justify-content: center; height: 100%; color: #999; }
.webmail-toolbar { display: flex; gap: 6px; }
.webmail-toolbar .btn { padding: 4px 10px; font-size: 0.8rem; }
</style>

<section class="about__area section-space-top section-space-bottom-1">
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="ri-mail-line"></i> Webmail</h4>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-success" id="connStatus"><i class="ri-checkbox-circle-fill"></i> Connected</span>
            <span class="text-muted"><i class="ri-user-line"></i> <%= currentUser %></span>
            <button class="btn btn-primary btn-sm" onclick="showComposeModal()"><i class="ri-edit-line"></i> Compose</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="refreshInbox()"><i class="ri-refresh-line"></i> Refresh</button>
            <a href="/webmail/logout" class="btn btn-outline-danger btn-sm"><i class="ri-logout-box-line"></i> Logout</a>
        </div>
    </div>

    <div class="webmail-container border rounded">
        <div class="webmail-list">
            <div class="webmail-list-header">
                <h6>Inbox</h6>
                <span class="badge bg-primary" id="inboxCount"><%= emails.length %></span>
            </div>
            <div class="webmail-items" id="emailList">
                <% if (emails && emails.length > 0) { %>
                    <% emails.forEach(function(mail) { %>
                        <div class="webmail-item <%= !mail.seen ? 'unread' : '' %>" data-uid="<%= mail.uid %>" onclick="loadEmail(<%= mail.uid %>)">
                            <div class="webmail-from"><%= mail.name || mail.from %></div>
                            <div class="webmail-subject"><%= mail.subject %></div>
                            <div class="webmail-date"><%= new Date(mail.date).toLocaleString('id-ID', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="webmail-empty">
                        <div class="text-center">
                            <i class="ri-mail-open-line fs-1"></i>
                            <p>No emails</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="webmail-content" id="emailContent">
            <div class="webmail-empty" id="emptyState">
                <div class="text-center">
                    <i class="ri-mail-open-line fs-1"></i>
                    <p>Select an email to read</p>
                </div>
            </div>
            <div id="emailView" style="display:none; flex-direction:column; height:100%;">
                <div class="webmail-content-header">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 id="emailSubject"></h5>
                        <div class="webmail-toolbar">
                            <button class="btn btn-outline-primary" id="btnReply" title="Reply"><i class="ri-reply-line"></i></button>
                            <button class="btn btn-outline-warning" id="btnToggleSeen" title="Toggle Read"><i class="ri-mail-open-line"></i></button>
                            <button class="btn btn-outline-danger" id="btnDelete" title="Delete"><i class="ri-delete-bin-line"></i></button>
                        </div>
                    </div>
                    <div class="meta mt-2">
                        <div><strong>From:</strong> <span id="emailFrom"></span></div>
                        <div><strong>To:</strong> <span id="emailTo"></span></div>
                        <div><strong>Date:</strong> <span id="emailDate"></span></div>
                    </div>
                </div>
                <div class="webmail-content-body" id="emailBody"></div>
            </div>
        </div>
    </div>
</div>
</section>

<!-- Compose Modal -->
<div class="modal fade" id="composeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ri-mail-send-line"></i> Compose</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">To</label>
                    <input type="email" class="form-control" id="composeTo" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Subject</label>
                    <input type="text" class="form-control" id="composeSubject" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea class="form-control" id="composeBody" rows="10" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="sendEmail()"><i class="ri-send-plane-fill"></i> Send</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script>
const socket = io();
let currentUid = null;

socket.on('connect', function() {
    document.getElementById('connStatus').innerHTML = '<i class="ri-checkbox-circle-fill"></i> Connected';
    document.getElementById('connStatus').className = 'badge bg-success';
});

socket.on('disconnect', function() {
    document.getElementById('connStatus').innerHTML = '<i class="ri-close-circle-fill"></i> Disconnected';
    document.getElementById('connStatus').className = 'badge bg-danger';
});

socket.on('new-email', function(data) {
    var exists = document.querySelector('[data-uid="' + data.uid + '"]');
    if (!exists) {
        var item = document.createElement('div');
        item.className = 'webmail-item unread';
        item.setAttribute('data-uid', data.uid);
        item.setAttribute('onclick', 'loadEmail(' + data.uid + ')');
        item.innerHTML = '<div class="webmail-from">' + (data.name || data.from) + '</div>' +
            '<div class="webmail-subject">' + data.subject + '</div>' +
            '<div class="webmail-date">' + data.date + '</div>';
        var list = document.getElementById('emailList');
        list.insertBefore(item, list.firstChild);
        var count = document.getElementById('inboxCount');
        count.textContent = parseInt(count.textContent) + 1;
    }
});

socket.on('email-deleted', function(data) {
    var item = document.querySelector('[data-uid="' + data.uid + '"]');
    if (item) {
        item.remove();
        var count = document.getElementById('inboxCount');
        count.textContent = Math.max(0, parseInt(count.textContent) - 1);
    }
    if (currentUid == data.uid) {
        document.getElementById('emailView').style.display = 'none';
        document.getElementById('emptyState').style.display = 'flex';
    }
});

function loadEmail(uid) {
    currentUid = uid;
    document.querySelectorAll('.webmail-item').forEach(function(el) { el.classList.remove('active'); });
    var item = document.querySelector('[data-uid="' + uid + '"]');
    if (item) {
        item.classList.add('active');
        item.classList.remove('unread');
    }

    document.getElementById('emptyState').style.display = 'none';
    document.getElementById('emailView').style.display = 'flex';
    document.getElementById('emailBody').innerHTML = '<div class="text-center p-4"><i class="ri-loader-4-line fs-3"></i> Loading...</div>';

    fetch('/api/mail/' + uid)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var e = data.email;
                document.getElementById('emailSubject').textContent = e.subject;
                document.getElementById('emailFrom').textContent = e.from;
                document.getElementById('emailTo').textContent = e.to;
                document.getElementById('emailDate').textContent = new Date(e.date).toLocaleString('id-ID');
                document.getElementById('emailBody').innerHTML = e.html || '<pre style="white-space:pre-wrap;font-family:inherit;">' + (e.text || '') + '</pre>';
                document.getElementById('btnReply').setAttribute('onclick', 'window.location.href="/mail/reply/' + uid + '?from=webmail"');
                document.getElementById('btnDelete').setAttribute('onclick', 'deleteEmail(' + uid + ')');
                document.getElementById('btnToggleSeen').setAttribute('onclick', 'toggleSeen(' + uid + ')');
            }
        })
        .catch(function(err) {
            document.getElementById('emailBody').innerHTML = '<div class="alert alert-danger">Failed to load email</div>';
        });
}

function deleteEmail(uid) {
    Swal.fire({
        title: 'Delete Email?',
        text: 'This email will be permanently deleted.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Yes, delete'
    }).then(function(result) {
        if (result.isConfirmed) {
            fetch('/api/mail/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ uid: uid })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Deleted', timer: 1000, showConfirmButton: false });
                }
            });
        }
    });
}

function toggleSeen(uid) {
    fetch('/api/mail/seen', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uid: uid, seen: true })
    }).then(function() { location.reload(); });
}

function showComposeModal() {
    document.getElementById('composeTo').value = '';
    document.getElementById('composeSubject').value = '';
    document.getElementById('composeBody').value = '';
    new bootstrap.Modal(document.getElementById('composeModal')).show();
}

function sendEmail() {
    var to = document.getElementById('composeTo').value;
    var subject = document.getElementById('composeSubject').value;
    var text = document.getElementById('composeBody').value;

    if (!to || !subject) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'To and Subject are required' });
        return;
    }

    fetch('/api/mail/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: to, subject: subject, text: text })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            Swal.fire({ icon: 'success', title: 'Email Sent', timer: 1500, showConfirmButton: false })
                .then(function() { bootstrap.Modal.getInstance(document.getElementById('composeModal')).hide(); });
        } else {
            Swal.fire({ icon: 'error', title: 'Send Failed', text: data.error });
        }
    })
    .catch(function(err) { Swal.fire({ icon: 'error', title: 'Error', text: err.message }); });
}

function refreshInbox() {
    location.reload();
}
</script>

<style>
  .settings-card { background: var(--bg-card); border: 1px solid var(--border-soft); border-radius: 10px; padding: 24px; max-width: 600px; }
  .settings-card h3 { margin-bottom: 16px; font-size: 1.1rem; color: var(--text-main); }
  .settings-row { margin-bottom: 16px; }
  .settings-row label { display: block; font-size: 0.82rem; font-weight: 600; color: var(--text-main); margin-bottom: 6px; }
  .settings-row input, .settings-row textarea { width: 100%; border: 1px solid var(--border-color); border-radius: 6px; padding: 8px 12px; font-size: 0.88rem; background: var(--bg-card); color: var(--text-main); }
  .settings-row input:focus, .settings-row textarea:focus { outline: none; border-color: var(--primary); }
  .settings-row textarea { min-height: 100px; resize: vertical; font-family: inherit; }
  .settings-row .hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; }
  .settings-actions { display: flex; gap: 8px; margin-top: 20px; }
  .settings-actions button { padding: 8px 20px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-main); cursor: pointer; transition: all 0.15s; }
  .settings-actions .btn-save { background: var(--primary); color: #fff; border-color: var(--primary); }
  .settings-actions .btn-save:hover { opacity: 0.9; }
  .settings-preview { margin-top: 20px; padding: 16px; border: 1px solid var(--border-soft); border-radius: 8px; background: var(--bg-soft); }
  .settings-preview h4 { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; }
  .settings-preview .preview-sig { font-size: 0.85rem; line-height: 1.5; color: var(--text-main); white-space: pre-wrap; }
</style>

<div class="page-content">
  <div class="breadcrumb-bar">
    <a href="/dashboard">Home</a>
    <i class="fa-solid fa-angle-right" style="font-size:0.6rem"></i>
    <a href="/webmail">Email</a>
    <i class="fa-solid fa-angle-right" style="font-size:0.6rem"></i>
    <span>Settings</span>
  </div>
  <div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
      <h1>Webmail Settings</h1>
      <p class="subtitle">Manage your email identity for <strong><%= currentUser %></strong></p>
    </div>
    <a class="btn-ghost" href="/webmail"><i class="fa-solid fa-arrow-left"></i> Back to Inbox</a>
  </div>

  <div class="mail-layout">
    <div class="mail-side">
      <a class="mail-compose-btn" href="/webmail/compose">
        <i class="fa-solid fa-pen-to-square"></i> Compose
      </a>
      <a class="mail-folder" href="/webmail">
        <i class="fa-solid fa-inbox"></i> Inbox
      </a>
      <a class="mail-folder" href="/webmail?folder=sent">
        <i class="fa-solid fa-paper-plane"></i> Sent
      </a>
      <div class="mail-side-divider"></div>
      <a class="mail-folder active" href="/webmail/settings">
        <i class="fa-solid fa-gear"></i> Settings
      </a>
    </div>
    <div class="mail-main">
      <div class="settings-card">
        <h3><i class="fa-solid fa-user-pen"></i> Identity</h3>
        <div class="settings-row">
          <label>Display Name</label>
          <input type="text" id="displayName" placeholder="e.g. Imas" value="<%= profile ? (profile.display_name || '') : '' %>" />
          <div class="hint">This name appears in the "From" field when you send emails</div>
        </div>
        <div class="settings-row">
          <label>Signature</label>
          <textarea id="signature" placeholder="e.g. Regards,&#10;Imas&#10;Customer Support"><%= profile ? (profile.signature || '') : '' %></textarea>
          <div class="hint">Appended to the bottom of your outgoing messages</div>
        </div>
        <div class="settings-actions">
          <button class="btn-save" onclick="saveSettings()"><i class="fa-solid fa-check"></i> Save Settings</button>
        </div>

        <div class="settings-preview">
          <h4>Preview - Your emails will show as:</h4>
          <div id="previewFrom" style="font-weight:600;font-size:0.9rem;margin-bottom:8px;color:var(--text-main)"><%= profile && profile.display_name ? profile.display_name : currentUser %></div>
          <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:12px">&lt;<%= currentUser %>&gt;</div>
          <div class="preview-sig" id="previewSig"><%= profile && profile.signature ? profile.signature : '(No signature set)' %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
var displayNameInput = document.getElementById('displayName');
var signatureInput = document.getElementById('signature');

displayNameInput.addEventListener('input', updatePreview);
signatureInput.addEventListener('input', updatePreview);

function updatePreview() {
  var name = displayNameInput.value.trim();
  document.getElementById('previewFrom').textContent = name || '<%= currentUser %>';
  document.getElementById('previewSig').textContent = signatureInput.value || '(No signature set)';
}

function saveSettings() {
  var btn = document.querySelector('.btn-save');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

  fetch('/api/mail/profile', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      display_name: displayNameInput.value.trim(),
      signature: signatureInput.value
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-check"></i> Save Settings';
    if (data.success) {
      whpToast('Saved', 'Profile updated successfully.', 'success');
    } else {
      whpToast('Error', data.error || 'Failed to save', 'error');
    }
  })
  .catch(function() {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-check"></i> Save Settings';
    whpToast('Error', 'Connection failed', 'error');
  });
}
</script>

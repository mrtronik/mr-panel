                            </div>
                        </div>
                    </div>
                </div>
             </section>
<section class="about__area section-space-top section-space-bottom-1">
                <div class="container">

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/mail/inbox" class="btn btn-secondary"><i class="ri-arrow-left-line"></i> Back to Inbox</a>
    <a href="/mail/reply/<%= typeof uid !== 'undefined' ? uid : '' %>?from=inbox" class="btn btn-primary"><i class="ri-reply-fill"></i> Reply</a>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="mb-3"><%= email.subject || "(No Subject)" %></h4>
        <hr>
        <div class="mb-3">
            <p class="mb-1"><strong>From:</strong> <%= email.from ? email.from.text : "-" %></p>
            <p class="mb-1"><strong>To:</strong> <%= email.to ? email.to.text : "-" %></p>
            <% if (email.cc) { %>
                <p class="mb-1"><strong>CC:</strong> <%= email.cc.text %></p>
            <% } %>
            <p class="mb-0"><strong>Date:</strong> <%= email.date %></p>
        </div>
        <hr>
        <div class="email-body">
            <% if(email.html){ %>
                <iframe srcdoc="<%= email.html.replace(/"/g, '&quot;') %>" sandbox="allow-same-origin" style="width:100%;min-height:400px;border:none;background:#fff;"></iframe>
            <% }else{ %>
                <pre class="mb-0" style="white-space:pre-wrap;font-family:inherit;"><%= email.text %></pre>
            <% } %>
        </div>
    </div>
</div>

    </div>
</section>



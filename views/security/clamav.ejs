<section class="about__area section-space-top section-space-bottom-1">
                <div class="container">

<% if (!status.installed) { %>
<div class="alert alert-warning">
    <i class="ri-error-warning-line"></i> <strong>ClamAV tidak terinstall!</strong>
    <hr>
    <p class="mb-0">Install ClamAV di VPS untuk menggunakan fitur ini:</p>
    <code>sudo apt update && sudo apt install clamav clamav-daemon -y<br>
sudo systemctl enable clamav-daemon<br>
sudo freshclam</code>
</div>
<% } else { %>

<!-- Status Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-<%= status.daemonRunning ? 'success' : 'warning' %> text-white">
            <div class="card-body text-center">
                <i class="ri-shield-check-line" style="font-size: 2rem;"></i>
                <h5 class="mt-2 mb-0"><%= status.daemonRunning ? 'Active' : 'Inactive' %></h5>
                <small>ClamAV Daemon</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="ri-database-2-line" style="font-size: 2rem;"></i>
                <h5 class="mt-2 mb-0">v<%= status.dbVersion %></h5>
                <small>Virus Database</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="ri-calendar-line" style="font-size: 2rem;"></i>
                <h5 class="mt-2 mb-0"><%= status.dbDate %></h5>
                <small>Last Updated</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-dark text-white">
            <div class="card-body text-center">
                <button class="btn btn-light btn-sm" onclick="updateDatabase()"><i class="ri-refresh-line"></i> Update DB</button>
                <small class="d-block mt-2">Update virus definitions</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Scan Form -->
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><strong><i class="ri-scan-line"></i> Scan Files</strong></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">File/Directory Path</label>
                    <input type="text" class="form-control" id="scanPath" placeholder="/home/user/public_html/">
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="recursiveScan" checked>
                    <label class="form-check-label" for="recursiveScan">Scan sub-directories (recursive)</label>
                </div>
                <button class="btn btn-primary" onclick="startScan()"><i class="ri-scan-line"></i> Start Scan</button>
            </div>
        </div>

        <!-- Scan Result -->
        <div class="card mb-4" id="scanResult" style="display:none;">
            <div class="card-header"><strong><i class="ri-file-list-line"></i> Scan Result</strong></div>
            <div class="card-body" id="scanResultContent"></div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><strong><i class="ri-tools-line"></i> Quick Actions</strong></div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-primary" onclick="scanPath('/home')"><i class="ri-folder-line"></i> Scan /home</button>
                    <button class="btn btn-outline-primary" onclick="scanPath('/var/www')"><i class="ri-folder-line"></i> Scan /var/www</button>
                    <button class="btn btn-outline-primary" onclick="scanPath('/tmp')"><i class="ri-folder-line"></i> Scan /tmp</button>
                    <button class="btn btn-outline-danger" onclick="scanPath('/tmp', true)"><i class="ri-folder-line"></i> Full Scan System</button>
                </div>
            </div>
        </div>

        <!-- Quarantine Info -->
        <div class="card mb-4">
            <div class="card-header"><strong><i class="ri-lock-line"></i> Quarantine</strong></div>
            <div class="card-body">
                <p class="text-muted">File yang terinfekti akan dipindahkan ke <code>/var/quarantine</code></p>
                <p class="text-muted mb-0">Total files: <strong id="quarantineCount"><%= quarantined.length %></strong></p>
            </div>
        </div>
    </div>
</div>

<!-- Scan Logs -->
<div class="card mb-4">
    <div class="card-header">
        <strong><i class="ri-file-list-3-line"></i> Scan History</strong>
        <div class="float-end">
            <button class="btn btn-sm btn-outline-danger" onclick="clearLogs()"><i class="ri-delete-bin-line"></i> Clear Logs</button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Type</th>
                        <th>Target</th>
                        <th>Result</th>
                        <th>Virus</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                    <tr><td colspan="5" class="text-center text-muted">Belum ada scan history</td></tr>
                    <% } else { %>
                    <% logs.forEach(log => { %>
                    <tr>
                        <td><small><%= new Date(log.created_at).toLocaleString() %></small></td>
                        <td><span class="badge bg-secondary"><%= log.scan_type %></span></td>
                        <td><small><%= log.target_path.substring(0, 50) %></small></td>
                        <td><span class="badge bg-<%= log.result === 'clean' ? 'success' : 'danger' %>"><%= log.result %></span></td>
                        <td><%= log.virus_name || '-' %></td>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quarantined Files -->
<div class="card mb-4">
    <div class="card-header"><strong><i class="ri-lock-line"></i> Quarantined Files</strong></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size</th>
                        <th>Quarantined At</th>
                        <th width="150">Actions</th>
                    </tr>
                </thead>
                <tbody id="quarantineBody">
                    <% if (quarantined.length === 0) { %>
                    <tr><td colspan="4" class="text-center text-muted">Tidak ada file di quarantine</td></tr>
                    <% } else { %>
                    <% quarantined.forEach(file => { %>
                    <tr>
                        <td><code><%= file.name %></code></td>
                        <td><%= file.sizeFormatted %></td>
                        <td><small><%= new Date(file.quarantinedAt).toLocaleString() %></small></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteQuarantined('<%= file.name %>')"><i class="ri-delete-bin-line"></i></button>
                        </td>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<% } %>

    </div>
</section>

<script>
async function startScan() {
    const path = document.getElementById('scanPath').value.trim();
    if (!path) {
        Swal.fire('Error', 'Masukkan path file/directory', 'error');
        return;
    }

    const recursive = document.getElementById('recursiveScan').checked;
    
    Swal.fire({
        title: 'Scanning...',
        text: 'Sedang memindai file, mohon tunggu',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    try {
        const res = await fetch('/api/clamav/scan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dirPath: path, recursive })
        });
        const data = await res.json();
        
        Swal.close();
        
        if (data.success) {
            showScanResult(data.data);
        } else {
            Swal.fire('Error', data.message, 'error');
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}

function scanPath(path, recursive = false) {
    document.getElementById('scanPath').value = path;
    document.getElementById('recursiveScan').checked = recursive;
    startScan();
}

function showScanResult(result) {
    const container = document.getElementById('scanResultContent');
    const card = document.getElementById('scanResult');
    card.style.display = 'block';
    
    let html = '';
    if (result.clean) {
        html = `
            <div class="alert alert-success">
                <i class="ri-check-line"></i> <strong>Bersih!</strong> Tidak ditemukan malware.
            </div>
            <p>Files scanned: <strong>${result.totalScanned || 0}</strong></p>
        `;
    } else {
        html = `
            <div class="alert alert-danger">
                <i class="ri-error-warning-line"></i> <strong>Bahaya!</strong> Ditemukan malware!
            </div>
            <p>Virus ditemukan:</p>
            <ul class="list-group mb-3">
                ${result.infected ? result.infected.map(i => `
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <code>${escapeHtml(i.file)}</code>
                        <span class="badge bg-danger">${escapeHtml(i.virus)}</span>
                    </li>
                `).join('') : ''}
            </ul>
        `;
    }
    
    container.innerHTML = html;
}

async function updateDatabase() {
    Swal.fire({
        title: 'Updating virus database...',
        text: 'Mengupdate definitions dari server ClamAV',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    try {
        const res = await fetch('/api/clamav/update', { method: 'POST' });
        const data = await res.json();
        
        if (data.success) {
            Swal.fire('Berhasil', 'Virus database berhasil diupdate', 'success')
                .then(() => window.location.reload());
        } else {
            Swal.fire('Error', data.message, 'error');
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}

async function clearLogs() {
    const result = await Swal.fire({
        title: 'Hapus Logs?',
        text: 'Semua scan history akan dihapus',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Hapus'
    });

    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/clamav/logs/clear', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', 'Logs berhasil dihapus', 'success')
                    .then(() => window.location.reload());
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function deleteQuarantined(fileName) {
    const result = await Swal.fire({
        title: 'Hapus File?',
        text: `File "${fileName}" akan dihapus permanen dari quarantine`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Hapus'
    });

    if (result.isConfirmed) {
        try {
            const res = await fetch(`/api/clamav/quarantine/${encodeURIComponent(fileName)}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                Swal.fire('Berhasil', 'File berhasil dihapus', 'success')
                    .then(() => window.location.reload());
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

function escapeHtml(text) {
    if (!text) return '';
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return String(text).replace(/[&<>"']/g, m => map[m]);
}
</script>

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title"><i class="ri-database-line"></i> phpMyAdmin</h4>
                    </div>
                </div>
            </div>

            <% if (installed) { %>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                                <div>
                                    <h5 class="mb-0">phpMyAdmin <small class="text-muted">v<%= version %></small></h5>
                                </div>
                                <div>
                                    <a href="<%= pmaUrl %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="ri-external-link-line"></i> Open in new tab
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deletePma()">
                                        <i class="ri-delete-bin-line"></i> Uninstall
                                    </button>
                                </div>
                            </div>
                            <iframe src="<%= pmaUrl %>" style="width:100%; height:calc(100vh - 200px); border:none;"></iframe>
                        </div>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <i class="ri-database-line fs-1 text-muted"></i>
                            <h5 class="mt-3">phpMyAdmin Not Installed</h5>
                            <p class="text-muted">Install phpMyAdmin to manage MySQL databases via web interface.</p>
                            <button class="btn btn-primary" id="btnInstallPma" onclick="installPma()">
                                <i class="ri-download-line"></i> Install phpMyAdmin
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<script>
async function installPma() {
    const btn = document.getElementById('btnInstallPma');
    btn.disabled = true;
    btn.innerHTML = '<i class="ri-loader-4-line ri-spin"></i> Installing...';
    
    try {
        const res = await fetch('/api/phpmyadmin/install', { method: 'POST' });
        const data = await res.json();
        if (data.error) Swal.fire('Error', data.error, 'error');
        else Swal.fire('Success', 'phpMyAdmin installed!', 'success').then(() => location.reload());
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="ri-download-line"></i> Install phpMyAdmin';
    }
}

async function deletePma() {
    const result = await Swal.fire({ title: 'Uninstall phpMyAdmin?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Yes, uninstall' });
    if (result.isConfirmed) {
        const res = await fetch('/api/phpmyadmin/delete', { method: 'POST' });
        const data = await res.json();
        if (data.error) Swal.fire('Error', data.error, 'error');
        else Swal.fire('Uninstalled!', 'phpMyAdmin removed.', 'success').then(() => location.reload());
    }
}
</script>
